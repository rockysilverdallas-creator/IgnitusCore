{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "rewrites": [
    { "source": "/api/twilio/:action", "destination": "/api/twilio?action=:action" },
    { "source": "/api/tiana", "destination": "/api/tiana.js" },
    { "source": "/api/shah", "destination": "/api/shah.js" },
    { "source": "/api/chat", "destination": "/api/shah.js" },
    { "source": "/api/spark_gemma", "destination": "/api/spark_gemma.js" },
    { "source": "/api/optin", "destination": "/api/optin.js" },
    { "source": "/api/optin_consent", "destination": "/api/optin.js" },
    { "source": "/api/stream", "destination": "/api/mesh.js?stream=1" }
  ]
}
